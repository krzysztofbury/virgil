# ── Virgil — Environment Variables ────────────────────────────

# Cloudflare Tunnel token — from Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# Auto-deploy (watchtower) — how often to poll GHCR for a new image (seconds)
WATCHTOWER_POLL_INTERVAL=300
# Path to the host's docker config with the ghcr.io login (docker login ghcr.io)
DOCKER_CONFIG_JSON=~/.docker/config.json

# Host directory for backups and pre-migration snapshots, mounted at /backups.
# Keep it off the data directory, ideally on another disk or share with a Linux
# filesystem (not exFAT or FAT), and make it writable by uid 1000 before
# `docker compose up -d`, which refuses to start if it is missing.
VIRGIL_BACKUP_HOST_DIR=./backups

# Optional: a Slack-style webhook that takes {"text": "..."}. Virgil posts here
# when a start leaves a database unmigrated, and autoheal each time it restarts
# a virgil that stopped answering.
ALERT_WEBHOOK_URL=

# Optional: encrypted off-site copies (docs/recovery.md). Once a day every
# account's database, the registry and the encryption key are uploaded to an
# S3-compatible bucket, each file compressed and encrypted to the age public key
# below. Its secret key opens every copy: keep it off this machine, for example
# in a password manager. Make the pair with
#   docker compose run --rm --no-deps virgil /app/.venv/bin/python scripts/recovery.py keygen --identity-file /tmp/id.txt
# (or age-keygen). For Cloudflare R2: the endpoint is
# https://<account id>.r2.cloudflarestorage.com, and the keys are an R2 API token
# with Object Read & Write on this bucket only. Retention is the bucket's
# lifecycle rules. Set all five or none; a partial set is reported at startup.
VIRGIL_OFFSITE_ENDPOINT=
VIRGIL_OFFSITE_BUCKET=
VIRGIL_OFFSITE_ACCESS_KEY_ID=
VIRGIL_OFFSITE_SECRET_ACCESS_KEY=
VIRGIL_OFFSITE_RECIPIENT=

# Optional: a message from Watchtower for each deploy of a new image, and for each
# poll (every WATCHTOWER_POLL_INTERVAL) while an update keeps failing, such as
# after a registry login expires. This is a shoutrrr URL, not a plain one: for
# the same webhook as above, replace https:// with generic:// and add
# template=json&messagekey=text to its query (with ? or &); an http:// webhook
# also needs disabletls=yes. Telegram has a form of its own. For example
#   generic://hooks.example.com/hook/123?template=json&messagekey=text
#   telegram://<bot token>@telegram?chats=<chat id>
# Other services: https://containrrr.dev/shoutrrr/v0.8/services/overview/
# An invalid URL stops Watchtower, and with it every deploy: after setting it,
# `docker logs virgil-watchtower` must show "Using notifications: <service>".
# A send that fails on the network logs the full URL, secret included.
WATCHTOWER_NOTIFICATION_URL=

# Encryption key for LLM API keys at rest (optional)
# If empty, auto-generates to /data/virgil.key on first run
VIRGIL_ENCRYPTION_KEY=

# Internal LLM — used for onboarding and system features
# Default model: gemini/gemini-3-flash-preview (requires Google AI API key)
# Override with any LiteLLM model string (e.g., anthropic/claude-sonnet-4-20250514)
VIRGIL_INTERNAL_LLM_MODEL=gemini/gemini-3-flash-preview
VIRGIL_INTERNAL_LLM_KEY=

# Multi-user — admin emails (comma-separated, always have admin role)
VIRGIL_ADMIN_EMAILS=admin@example.com

# Registration open/closed (default: false — closed).
# The FIRST account can always be created even when closed (bootstrap owner).
VIRGIL_REGISTRATION_OPEN=false

# Time zone for every "today" (streaks, today's entries, future-date checks).
# Without it the container runs on UTC and the day turns at the wrong hour.
TZ=Europe/Warsaw

# Trust CF-Connecting-IP for rate limiting only when Cloudflare Tunnel is the
# sole ingress to Virgil. Without it every visitor shares cloudflared's address,
# so ten failed logins from anyone lock everybody out for a minute. List the
# cloudflared peer as an IP or as a CIDR range covering the compose network
# (cloudflared gets a new address when it is recreated); see its subnet with
# `docker network inspect <project>_virgil-net`, for example 172.18.0.0/16.
# Keep both empty/false for direct or LAN development.
VIRGIL_TRUST_CLOUDFLARE_HEADERS=false
VIRGIL_TRUSTED_PROXY_IPS=

# REST API and /mcp for external tools (reads plus bounded domain writes).
# Each account can create its own API tokens under Settings > Security; this
# server key is the older single-account alternative. The API is off while
# neither exists. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
VIRGIL_API_KEY=
# Required when VIRGIL_API_KEY is set: the only account that key may read or write.
# Empty used to mean "first active admin", which could move onto another account.
# Leave empty only when the API is disabled. An empty or inactive value returns 503.
VIRGIL_API_USER_EMAIL=
# Expose Freedom data, /api/noporn included, via the server key (default: false).
# Tokens carry their own sensitive scope.
VIRGIL_API_SENSITIVE=false
# Expose /api/finance (account balances, cushion, score) via the server key (default: false).
# Tokens carry their own finance scope.
VIRGIL_API_FINANCE=false
