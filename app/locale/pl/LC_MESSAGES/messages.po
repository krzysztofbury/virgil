#: app/templates/auth_mfa_setup.html
msgid "Virgil - MFA Setup"
msgstr "Virgil - Konfiguracja MFA"

#: app/templates/auth_mfa_setup.html
msgid "Two-Factor Authentication"
msgstr "Uwierzytelnianie dwuskładnikowe"

#: app/templates/auth_mfa_setup.html
msgid "MFA is enabled"
msgstr "MFA jest włączone"

#: app/templates/auth_mfa_setup.html
msgid "Your account is protected with a TOTP authenticator app."
msgstr "Twoje konto chroni aplikacja uwierzytelniająca TOTP."

#: app/templates/auth_mfa_setup.html
msgid "Disable MFA"
msgstr "Wyłącz MFA"

#: app/templates/auth_mfa_setup.html
msgid "Confirm your password"
msgstr "Potwierdź hasło"

#: app/templates/auth_mfa_setup.html
msgid "Set up MFA"
msgstr "Skonfiguruj MFA"

#: app/templates/auth_mfa_setup.html
msgid "Scan the QR code with your authenticator app (Google Authenticator, Authy, etc.), then enter the 6-digit code to confirm."
msgstr "Zeskanuj kod QR aplikacją uwierzytelniającą (Google Authenticator, Authy itp.), a potem wpisz 6-cyfrowy kod, żeby potwierdzić."

#: app/templates/auth_mfa_setup.html
msgid "QR Code"
msgstr "Kod QR"

#: app/templates/auth_mfa_setup.html
msgid "Manual entry key"
msgstr "Klucz do ręcznego wpisania"

#: app/templates/auth_mfa_setup.html
msgid "Verification Code"
msgstr "Kod weryfikacyjny"

#: app/templates/auth_mfa_setup.html
msgid "Enable MFA"
msgstr "Włącz MFA"

#: app/templates/auth_mfa_setup.html
msgid "Back to Settings"
msgstr "Wróć do ustawień"

#: app/templates/auth_mfa_verify.html
msgid "Virgil - Verify MFA"
msgstr "Virgil - Weryfikacja MFA"

#: app/templates/auth_mfa_verify.html
msgid "Enter the 6-digit code from your authenticator app."
msgstr "Wpisz 6-cyfrowy kod z aplikacji uwierzytelniającej."

#: app/templates/auth_mfa_verify.html
msgid "Code"
msgstr "Kod"

#: app/templates/auth_mfa_verify.html
msgid "Verify"
msgstr "Potwierdź"

#: app/templates/auth_reset.html
msgid "Virgil - Reset password"
msgstr "Virgil - Reset hasła"

#: app/templates/auth_reset.html
#, python-format
msgid "Set a new password for %(email)s."
msgstr "Ustaw nowe hasło dla %(email)s."

#: app/templates/auth_reset.html
msgid "New password"
msgstr "Nowe hasło"

#: app/templates/auth_reset.html
msgid "Repeat new password"
msgstr "Powtórz nowe hasło"

#: app/templates/auth_reset.html
msgid "Set password"
msgstr "Ustaw hasło"

#: app/templates/auth_reset.html
msgid "Every device signed in to this account is signed out, and its API tokens are revoked."
msgstr "Wszystkie urządzenia zalogowane na to konto zostaną wylogowane, a jego tokeny API unieważnione."

