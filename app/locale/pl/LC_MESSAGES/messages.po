msgid "This account already has a password."
msgstr "To konto ma już hasło."

#: app/routers/auth.py
msgid "Password set. Other devices are signed out."
msgstr "Hasło ustawione. Inne urządzenia zostały wylogowane."

#: app/routers/auth.py
msgid "This server cannot send sign-in links, so the password stays."
msgstr "Ten serwer nie może wysyłać linków do logowania, więc hasło zostaje."

#: app/routers/auth.py
msgid "Password removed. You sign in with emailed links now."
msgstr "Hasło usunięte. Teraz logujesz się linkami wysyłanymi e-mailem."

#: app/routers/auth.py
msgid "MFA session expired. Sign in again."
msgstr "Sesja MFA wygasła. Zaloguj się ponownie."

#: app/routers/auth.py
#, python-brace-format
