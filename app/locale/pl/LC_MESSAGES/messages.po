# Polish translation of the Virgil UI (#152).
#
# Tone: informal second person ("Zapisz", "Twoje cele").
# Glossary, kept as is: Virgil, A.N.D.Y., Freedom, Oura, WOD, MCP, API.
# Fixed renderings: Dashboard = Pulpit, Daily = Dziennik, Training = Trening,
# Blood = Badania, Goals = Cele, Experiments = Eksperymenty, Finance = Finanse,
# Settings = Ustawienia. A.N.D.Y. areas: Body = Ciało, Spirit = Duch,
# Self/Account = Konto, Relations = Relacje. Fortress = Forteca.
msgid ""
msgstr ""
"Project-Id-Version: Virgil\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

#: app/csrf.py
msgid "CSRF validation failed. Reload the page and try again."
msgstr "Weryfikacja formularza nie powiodła się. Odśwież stronę i spróbuj ponownie."

#: app/routers/auth.py
msgid "This invite link is invalid, used or expired. Ask for a new one."
msgstr "Ten link z zaproszeniem jest nieprawidłowy, wykorzystany albo wygasł. Poproś o nowy."

#: app/routers/auth.py
msgid "This address is reserved on this server. Ask an admin for an invite made for it."
msgstr "Ten adres jest zarezerwowany na tym serwerze. Poproś administratora o zaproszenie wystawione na niego."

#: app/routers/auth.py
msgid "This reset link is invalid, used or expired. Ask an admin for a new one."
msgstr "Ten link do resetu hasła jest nieprawidłowy, wykorzystany albo wygasł. Poproś administratora o nowy."

#: app/routers/auth.py
msgid "Registration is closed on this server."
msgstr "Rejestracja na tym serwerze jest zamknięta."

#: app/routers/auth.py
msgid "Please enter a valid email address."
msgstr "Podaj prawidłowy adres e-mail."

#: app/routers/auth.py
msgid "Password must be at least 8 characters."
msgstr "Hasło musi mieć co najmniej 8 znaków."

#: app/routers/auth.py
msgid "Passwords do not match."
msgstr "Hasła się nie zgadzają."

#: app/routers/auth.py
msgid "This invite is for a different email address."
msgstr "To zaproszenie jest na inny adres e-mail."

#: app/routers/auth.py
msgid "An account with that email already exists."
msgstr "Konto z tym adresem e-mail już istnieje."

#: app/routers/auth.py
msgid "Could not create your account. Please try again."
msgstr "Nie udało się utworzyć konta. Spróbuj ponownie."

#: app/routers/auth.py
msgid "Account created."
msgstr "Konto utworzone."

#: app/routers/auth.py
msgid "Password set. Sign in with the new one."
msgstr "Hasło ustawione. Zaloguj się nowym hasłem."

#: app/routers/auth.py
msgid "Invalid email or password."
msgstr "Nieprawidłowy e-mail lub hasło."

#: app/routers/auth.py
msgid "This account has been deactivated."
msgstr "To konto zostało wyłączone."

#: app/routers/auth.py
msgid "Signed in."
msgstr "Zalogowano."

#: app/routers/auth.py
msgid "Signed out."
msgstr "Wylogowano."

#: app/routers/auth.py
msgid "MFA setup is unavailable. Start setup again."
msgstr "Konfiguracja MFA jest niedostępna. Zacznij od nowa."

#: app/routers/auth.py
msgid "Invalid code. Please try again."
msgstr "Nieprawidłowy kod. Spróbuj ponownie."

#: app/routers/auth.py
msgid "MFA enabled."
msgstr "MFA włączone."

#: app/routers/auth.py
msgid "MFA could not be disabled."
msgstr "Nie udało się wyłączyć MFA."

#: app/routers/auth.py
msgid "Invalid password."
msgstr "Nieprawidłowe hasło."

#: app/routers/auth.py
msgid "MFA disabled."
msgstr "MFA wyłączone."

#: app/routers/auth.py
msgid "Sign in again to change your password."
msgstr "Zaloguj się ponownie, żeby zmienić hasło."

#: app/routers/auth.py
msgid "Current password is incorrect."
msgstr "Obecne hasło jest nieprawidłowe."

#: app/routers/auth.py
msgid "New password must be at least 8 characters."
msgstr "Nowe hasło musi mieć co najmniej 8 znaków."

#: app/routers/auth.py
msgid "New passwords do not match."
msgstr "Nowe hasła się nie zgadzają."

#: app/routers/auth.py
msgid "Password changed. Other devices are signed out."
msgstr "Hasło zmienione. Inne urządzenia zostały wylogowane."

#: app/routers/auth.py
msgid "MFA session expired. Sign in again."
msgstr "Sesja MFA wygasła. Zaloguj się ponownie."

#: app/routers/auth.py
#, python-brace-format
msgid "Too many invalid codes. Try again in {num} minute."
msgid_plural "Too many invalid codes. Try again in {num} minutes."
msgstr[0] "Zbyt wiele błędnych kodów. Spróbuj ponownie za {num} minutę."
msgstr[1] "Zbyt wiele błędnych kodów. Spróbuj ponownie za {num} minuty."
msgstr[2] "Zbyt wiele błędnych kodów. Spróbuj ponownie za {num} minut."

#: app/routers/auth.py
msgid "Language changed."
msgstr "Zmieniono język."

#: app/static/js/components.js
msgid "Recently used"
msgstr "Ostatnio używane"

#: app/templates/auth_login.html
msgid "Virgil - Login"
msgstr "Virgil - Logowanie"

#: app/templates/auth_login.html
msgid "Sign in to continue."
msgstr "Zaloguj się, żeby kontynuować."

#: app/templates/auth_login.html
msgid "Sign In"
msgstr "Zaloguj się"

#: app/templates/auth_login.html
msgid "Don't have an account?"
msgstr "Nie masz konta?"

#: app/templates/auth_login.html
msgid "Sign up"
msgstr "Zarejestruj się"

