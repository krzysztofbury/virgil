#: app/routers/admin.py
msgid "Enter a valid email address, or leave it empty."
msgstr "Podaj prawidłowy adres e-mail albo zostaw puste."

#: app/routers/admin.py
msgid "Unknown role."
msgstr "Nieznana rola."

#: app/routers/admin.py
msgid "That invite was already used, revoked or expired."
msgstr "To zaproszenie zostało już wykorzystane, unieważnione albo wygasło."

#: app/routers/admin.py
msgid "Invite revoked."
msgstr "Zaproszenie unieważnione."

#: app/routers/admin.py
msgid "Change your own password under Settings > Security."
msgstr "Swoje hasło zmienisz w Ustawienia > Bezpieczeństwo."

#: app/routers/admin.py
#, python-brace-format
msgid "{email} is in VIRGIL_ADMIN_EMAILS; only its owner sets its password."
msgstr "{email} jest w VIRGIL_ADMIN_EMAILS; hasło ustawia tylko właściciel."

#: app/routers/admin.py
msgid "User account was not found."
msgstr "Nie znaleziono konta użytkownika."

#: app/routers/admin.py
msgid "Enable the account before resetting its password."
msgstr "Włącz konto, zanim zresetujesz jego hasło."

#: app/routers/admin.py
msgid "Manage your own two-factor under Settings > Security."
msgstr "Swoim uwierzytelnianiem dwuskładnikowym zarządzasz w Ustawienia > Bezpieczeństwo."

#: app/routers/admin.py
#, python-brace-format
msgid "{email} is in VIRGIL_ADMIN_EMAILS; only its owner manages its two-factor."
msgstr "{email} jest w VIRGIL_ADMIN_EMAILS; tylko jego właściciel zarządza jego uwierzytelnianiem dwuskładnikowym."

#: app/routers/admin.py
#, python-brace-format
msgid "Two-factor reset for {email}."
msgstr "Zresetowano uwierzytelnianie dwuskładnikowe dla {email}."

#: app/routers/admin.py
msgid "The account may use the server's LLM key."
msgstr "To konto może korzystać z klucza LLM serwera."

#: app/routers/admin.py
msgid "The account no longer uses the server's LLM key."
msgstr "To konto nie korzysta już z klucza LLM serwera."

#: app/routers/admin.py
msgid "Your own role cannot be changed from the admin panel."
msgstr "Własnej roli nie można zmienić w panelu administratora."

#: app/routers/admin.py
#, python-brace-format
msgid "{email} is in VIRGIL_ADMIN_EMAILS and stays an admin."
msgstr "{email} jest w VIRGIL_ADMIN_EMAILS i pozostaje administratorem."

#: app/routers/admin.py
msgid "Role changed."
msgstr "Rola zmieniona."

#: app/routers/admin.py
msgid "Your account cannot be disabled from the admin panel."
msgstr "Własnego konta nie można wyłączyć w panelu administratora."

#: app/routers/admin.py
#, python-brace-format
msgid "{email} is in VIRGIL_ADMIN_EMAILS and cannot be disabled."
msgstr "{email} jest w VIRGIL_ADMIN_EMAILS i nie można go wyłączyć."

#: app/routers/admin.py app/routers/settings.py
msgid "Another account operation is already in progress."
msgstr "Inna operacja na koncie już trwa."

#: app/routers/admin.py
msgid "Disable the user's remote subscriptions before disabling the account."
msgstr "Zanim wyłączysz konto, wyłącz zdalne subskrypcje użytkownika."

#: app/routers/admin.py
msgid "User account disabled."
msgstr "Konto użytkownika wyłączone."

#: app/routers/admin.py
msgid "User account enabled."
msgstr "Konto użytkownika włączone."

#: app/routers/admin.py
msgid "Your account cannot be deleted from the admin panel."
msgstr "Własnego konta nie można usunąć w panelu administratora."

#: app/routers/admin.py
#, python-brace-format
msgid "{email} is in VIRGIL_ADMIN_EMAILS and cannot be deleted."
msgstr "{email} jest w VIRGIL_ADMIN_EMAILS i nie można go usunąć."

#: app/routers/admin.py
msgid "Disable the user's remote subscriptions before deleting the account."
msgstr "Zanim usuniesz konto, wyłącz zdalne subskrypcje użytkownika."

#: app/routers/admin.py
msgid "User account deleted."
msgstr "Konto użytkownika usunięte."

#: app/routers/admin.py app/server_settings.py
msgid "That setting cannot be changed in the app."
msgstr "Tego ustawienia nie można zmienić w aplikacji."

#: app/routers/admin.py
msgid "Enter the new value. Reset returns to the environment's."
msgstr "Wpisz nową wartość. Reset przywraca wartość ze środowiska."

#: app/routers/admin.py
msgid "Saved. It applies now."
msgstr "Zapisano. Działa od teraz."

#: app/routers/admin.py
msgid "The environment's value applies again."
msgstr "Znowu obowiązuje wartość ze środowiska."

#: app/routers/admin.py app/routers/settings.py
msgid "Provider, model, and API key are required."
msgstr "Dostawca, model i klucz API są wymagane."

#: app/routers/admin.py app/routers/settings.py
msgid "AI key added."
msgstr "Klucz AI dodany."

#: app/routers/admin.py app/routers/settings.py
msgid "That AI key no longer exists."
msgstr "Ten klucz AI już nie istnieje."

#: app/routers/admin.py app/routers/settings.py
msgid "AI key in use."
msgstr "Klucz AI w użyciu."

#: app/routers/admin.py app/routers/settings.py
msgid "AI key removed."
msgstr "Klucz AI usunięty."

#: app/routers/auth.py
msgid "This invite link is invalid, used or expired. Ask for a new one."
msgstr "Ten link z zaproszeniem jest nieprawidłowy, wykorzystany albo wygasł. Poproś o nowy."

#: app/routers/auth.py
msgid "This address is reserved on this server. Ask an admin for an invite made for it."
msgstr "Ten adres jest zarezerwowany na tym serwerze. Poproś administratora o zaproszenie wystawione na niego."

#: app/routers/auth.py
msgid "This reset link is invalid, used or expired. Ask an admin for a new one."
msgstr "Ten link do resetu hasła jest nieprawidłowy, wykorzystany albo wygasł. Poproś administratora o nowy."

#: app/routers/auth.py
msgid "That link has expired. Ask for a new one."
msgstr "Ten link wygasł. Poproś o nowy."

#: app/routers/auth.py
msgid "Registration is closed on this server."
msgstr "Rejestracja na tym serwerze jest zamknięta."

#: app/routers/auth.py
msgid "Please enter a valid email address."
msgstr "Podaj prawidłowy adres e-mail."

#: app/routers/auth.py
msgid "Accept the terms and the privacy policy to create an account."
msgstr "Aby założyć konto, zaakceptuj regulamin i politykę prywatności."

#: app/routers/auth.py
msgid "An account with that email already exists."
msgstr "Konto z tym adresem e-mail już istnieje."

#: app/routers/auth.py
msgid "Password must be at least 8 characters."
msgstr "Hasło musi mieć co najmniej 8 znaków."

#: app/routers/auth.py
msgid "Passwords do not match."
msgstr "Hasła się nie zgadzają."

#: app/routers/auth.py
msgid "This invite is for a different email address."
msgstr "To zaproszenie jest na inny adres e-mail."

#: app/routers/auth.py
msgid "Could not create your account. Please try again."
msgstr "Nie udało się utworzyć konta. Spróbuj ponownie."

#: app/routers/auth.py
msgid "Account created."
msgstr "Konto utworzone."

#: app/routers/auth.py
msgid "Password set. Sign in with the new one."
msgstr "Hasło ustawione. Zaloguj się nowym hasłem."

#: app/routers/auth.py
msgid "Invalid email or password."
msgstr "Nieprawidłowy e-mail lub hasło."

#: app/routers/auth.py
msgid "This account has been deactivated."
msgstr "To konto zostało wyłączone."

#: app/routers/auth.py
msgid "Signed in."
msgstr "Zalogowano."

#: app/routers/auth.py
msgid "Signed out."
msgstr "Wylogowano."

#: app/routers/auth.py
msgid "MFA setup is unavailable. Start setup again."
msgstr "Konfiguracja MFA jest niedostępna. Zacznij od nowa."

#: app/routers/auth.py
msgid "Invalid code. Please try again."
msgstr "Nieprawidłowy kod. Spróbuj ponownie."

#: app/routers/auth.py
msgid "For this, sign in again with a new link first."
msgstr "Do tego zaloguj się najpierw ponownie nowym linkiem."

#: app/routers/auth.py
msgid "Password is incorrect."
msgstr "Nieprawidłowe hasło."

#: app/routers/auth.py
msgid "Two-factor authentication is not on."
msgstr "Uwierzytelnianie dwuskładnikowe nie jest włączone."

#: app/routers/auth.py
msgid "MFA could not be disabled."
msgstr "Nie udało się wyłączyć MFA."

#: app/routers/auth.py
msgid "Invalid password."
msgstr "Nieprawidłowe hasło."

#: app/routers/auth.py
msgid "MFA disabled."
msgstr "MFA wyłączone."

#: app/routers/auth.py
msgid "Sign in again to change your password."
msgstr "Zaloguj się ponownie, żeby zmienić hasło."

#: app/routers/auth.py
msgid "Current password is incorrect."
msgstr "Obecne hasło jest nieprawidłowe."

#: app/routers/auth.py
msgid "New password must be at least 8 characters."
msgstr "Nowe hasło musi mieć co najmniej 8 znaków."

#: app/routers/auth.py
msgid "New passwords do not match."
msgstr "Nowe hasła się nie zgadzają."

#: app/routers/auth.py
msgid "Password changed. Other devices are signed out."
msgstr "Hasło zmienione. Inne urządzenia zostały wylogowane."

